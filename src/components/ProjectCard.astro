---
interface Props {
  title: string;
  year?: string;
  description?: string;
  href: string;
  image?: string;
  imageAlt?: string;
  cardColour?: string;
  cardTextColour?: string;
  cardHoverTextColour?: string;
}

const { 
  title, 
  year, 
  description, 
  href, 
  image, 
  imageAlt, 
  cardColour = "#000000",
  cardTextColour = "#000000",
  cardHoverTextColour = cardTextColour,
} = Astro.props;
---

<div 
  class="project-card"
  style={{
    "--card-colour": cardColour,
    "--card-text-colour": cardTextColour,
    "--card-hover-text-colour": cardHoverTextColour,
  }}
>
  <a href={href}>
    {image && (
      <div class="project-card-image">
        <img src={image} alt={imageAlt || ""} loading="lazy" />
      </div>
    )}
    {!image && <div class="project-card-image"></div>}
    <div class="project-card-overlay" aria-hidden="true"></div>
    <div class="project-card-content">
      <div class="project-card-head">
        <div class="project-card-title-group">
          <h3 class="project-card-title">{title}</h3>
          {description && <p class="project-card-description">{description}</p>}
        </div>
        {year && <span class="project-card-year">{year}</span>}
      </div>
      <div class="project-card-foot">
        <div class="project-card-indicator">→</div>
      </div>
    </div>
  </a>
</div>
