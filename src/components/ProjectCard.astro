---
interface Props {
  title: string;
  year?: string;
  description?: string;
  href: string;
  image?: string;
  imageAlt?: string;
  cardColour?: string;
  cardTextColour?: "dark" | "light";
}

const { 
  title, 
  year, 
  description, 
  href, 
  image, 
  imageAlt, 
  cardColour = "#000000",
  cardTextColour = "light"
} = Astro.props;

const textClass = cardTextColour === "dark" ? "card-text-dark" : "card-text-light";
---

<div 
  class={`project-card ${textClass}`}
  style={cardColour ? { "--card-colour": cardColour } : {}}
>
  <a href={href}>
    {image && (
      <div class="project-card-image">
        <img src={image} alt={imageAlt || title} loading="lazy" />
      </div>
    )}
    {!image && <div class="project-card-image"></div>}
    <div class="project-card-overlay" aria-hidden="true"></div>
    <div class="project-card-content">
      <div class="project-card-head">
        <h3 class="project-card-title">{title}</h3>
        {year && <span class="project-card-year">{year}</span>}
      </div>
      <div class="project-card-foot">
        {description && <p class="project-card-description">{description}</p>}
        <div class="project-card-indicator">→</div>
      </div>
    </div>
  </a>
</div>
