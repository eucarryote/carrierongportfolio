---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("design");

const projectList = projects.map((project) => ({
  ...project.data,
  href: `/design/${project.slug}.html`,
}));

const title = "Carrie Rong — Design";
const description = "Design projects";
---

<BaseLayout title={title} description={description}>
  <div class="project-grid">
    {projectList.map((project) => (
      <ProjectCard
        title={project.title}
        description={project.description}
        year={project.year}
        href={project.href}
        image={project.heroImage}
        imageAlt={project.heroAlt}
        cardColour={project.cardColour}
        cardTextColour={project.cardTextColour}
      />
    ))}
  </div>
</BaseLayout>
